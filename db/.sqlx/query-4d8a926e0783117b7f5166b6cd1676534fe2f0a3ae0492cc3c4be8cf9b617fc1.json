  "query": "\n                SELECT \n                    id,\n                    room_name,\n                    room_code,\n                    status AS \"status: RoomStatus\",\n                    admin,\n                    players as \"players!: Json<Vec<Player>>\",\n                    max_players,\n                    spectators as \"spectators!: Json<Vec<Spectator>>\",\n                    max_spectators,\n                    created_at\n                FROM ROOMS\n                WHERE (id = $1)\n                ORDER BY created_at DESC\n            ",
