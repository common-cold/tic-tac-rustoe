  "query": "\n               SELECT\n                    id,\n                    room_id,\n                    players as \"players!: Json<Vec<Player>>\",\n                    state as \"state!: Json<Vec<Vec<Option<MoveType>>>>\",\n                    moves as \"moves!: Json<Vec<Move>>\",\n                    winner,\n                    is_completed,\n                    created_at,\n                    completed_at\n                FROM GAMES\n                WHERE ($1::uuid IS NULL OR id     = $1)\n                AND ($2::uuid IS NULL OR room_id = $2)\n            ",
